rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos: parent and junior drivers
    match /profile-photos/{filename} {
      allow read: if true; // Anyone can view profile photos
      
      // Allow write/delete if:
      // - User is authenticated
      // - Filename is either their own photo (userId.jpg) OR their junior's photo (userId_junior_0.jpg, etc.)
      allow write, delete: if request.auth != null && 
        (filename == request.auth.uid + '.jpg' || 
         filename.matches(request.auth.uid + '_junior_[0-9]+\\.jpg'));
      
      // File size limit: 10MB
      allow write: if request.resource.size < 10 * 1024 * 1024;
    }
  }
}
